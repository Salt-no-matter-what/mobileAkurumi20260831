<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <Button
        android:id="@+id/buttun_a"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="明示的Intent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttun_b"
        />
    <Button
        android:id="@+id/buttun_b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暗黙的Intent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttun_a"
        app:layout_constraintStart_toEndOf="@+id/buttun_a"/>
    <TextView
        android:id="@+id/textView_visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@+id/buttun_a"
        app:layout_constraintStart_toStartOf="parent"
        android:text="これは表示されている"
        />
    <TextView
        android:id="@+id/textView_invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@+id/textView_visible"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        android:text="これは表示されていない"
        />
    <TextView
        android:id="@+id/textView_gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textView_invisible"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        android:text="これも最初に表示される"
        />


    <EditText
        android:id="@+id/intent_editText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="MainActivity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_gone"
        app:layout_constraintEnd_toStartOf="@+id/intent_buttun"
        />

    <EditText
        android:id="@+id/intent_buttun"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="intent"
        app:layout_constraintStart_toEndOf="@id/intent_editText"
        app:layout_constraintTop_toTopOf="@id/intent_editText"
        app:layout_constraintEnd_toEndOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>